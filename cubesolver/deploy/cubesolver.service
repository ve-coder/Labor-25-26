[Unit]
Description=Cube-Solver (Weboberfläche + Steuerung)
After=network.target pigpiod.service
Wants=pigpiod.service

[Service]
User=__USER__
WorkingDirectory=__DIR__
Environment=CUBESOLVER_MODE=pi
ExecStart=__DIR__/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
